# ===== API =====
# Path the browser uses to reach the API. Keep "/api": Next.js proxies it to
# API_PROXY_TARGET, so auth cookies stay first-party.
NEXT_PUBLIC_API_URL=/api

# Where the Express API runs (server-side only, never sent to the browser).
# TODO: Replace with your deployed API URL in production, e.g. https://api.selfvibe.app
API_PROXY_TARGET=http://localhost:5000

# ===== Public site address (link previews, Day 10) =====
# TODO: Replace with your live https:// address in production, e.g. https://selfvibe.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Error tracking (Sentry, optional) =====
# TODO: Replace with your Sentry DSN (sentry.io → Project → Settings → Client Keys).
# Empty = off. The DSN is public by design (it only allows sending errors).
NEXT_PUBLIC_SENTRY_DSN=
