{
  "name": "selfvibe-api",
  "version": "1.0.0",
  "description": "SelfVibe REST API (Node.js + Express + MongoDB)",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --import ./tests/setup.js \"tests/**/*.test.js\"",
    "create-owner": "node scripts/createOwner.js",
    "seed:taxonomy": "node scripts/seedTaxonomy.js",
    "seed:artists": "node scripts/seedArtists.js",
    "worker": "node worker.js",
    "worker:dev": "node --watch worker.js",
    "import:catalog": "node --max-http-header-size=262144 scripts/importCatalog.js",
    "audio:reencode": "node scripts/reencodeAudio.js",
    "storage:cors": "node scripts/applyStorageCors.js",
    "db:sync-indexes": "node scripts/syncIndexes.js",
    "search:setup": "node scripts/setupSearch.js",
    "db:backup": "node scripts/backupDb.js"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@sentry/node": "^11.9.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.4.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "otplib": "^13.5.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10"
  }
}
