# ===== Server =====
PORT=5000
NODE_ENV=development
# info = one line per API call + warnings/errors. Use "debug" to also see internal service messages.
LOG_LEVEL=info
# Reverse-proxy hops in front of the API (Next.js /api proxy = 1)
TRUST_PROXY=1

# ===== Database =====
# TODO: Replace with your MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/selfvibe?retryWrites=true&w=majority
DATABASE_URL=your_database_connection_string_here

# ===== CORS =====
# Allowed frontend origin(s), comma-separated
CLIENT_URL=http://localhost:3000

# ===== Request limits =====
JSON_BODY_LIMIT=100kb

# ===== Auth: listeners & creators =====
# TODO: Replace with a long random secret (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# ===== Auth: staff console (Owner / Admin) =====
# TODO: Replace with a DIFFERENT long random secret (at least 32 characters)
STAFF_JWT_SECRET=your_staff_jwt_secret_here
STAFF_JWT_ACCESS_EXPIRES_IN=15m
STAFF_REFRESH_TOKEN_EXPIRES_HOURS=8
STAFF_IDLE_TIMEOUT_MINUTES=30

# ===== Two-factor authentication =====
# TODO: Replace with 64 hex characters (encrypts authenticator secrets). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=your_totp_encryption_key_here
# Name shown in the authenticator app
TOTP_ISSUER=SelfVibe

# ===== Cookies =====
# Must be true in production (HTTPS). Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false

# ===== Owner account (used only by `npm run create-owner`) =====
# TODO: Replace with the Owner's email and a strong password (12+ characters, letters and numbers)
OWNER_EMAIL=your_owner_email_here
OWNER_PASSWORD=your_owner_password_here
OWNER_NAME=Vishal Chavan

# ===== Web app URL =====
# Public URL of the frontend, used in emails and after Google sign-in
APP_URL=http://localhost:3000

# ===== Password reset =====
PASSWORD_RESET_TTL_MINUTES=30

# ===== Google OAuth (optional until set — "Continue with Google" shows "not available") =====
# TODO: Replace with your Google Cloud OAuth client (APIs & Services → Credentials → OAuth client ID → Web application)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Add this exact URL under "Authorized redirect URIs" in Google Cloud.
# It points at the FRONTEND (port 3000), which proxies /api to this server.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ===== Email (Resend) =====
# TODO: Replace with your Resend API key (resend.com → API Keys).
# Until set, development emails are saved to backend/.dev-emails/ instead of being sent.
RESEND_API_KEY=your_resend_api_key_here
# Sender address. "onboarding@resend.dev" works for testing; use your verified domain in production.
EMAIL_FROM=SelfVibe <onboarding@resend.dev>

# ===== Cloudinary (avatars, and music storage when CLOUDINARY_ACCOUNTS is empty) =====
# TODO: Replace with your Cloudinary credentials (Cloudinary console → Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ===== Music storage pool: several Cloudinary accounts (PRD 10.13, optional) =====
# Leave empty to store all music in the single account above (one "shared" account).
# To use several accounts, list them comma-separated, one entry per account:
#   key|pool|cloudName|apiKey|apiSecret|quotaGb
#   key     = a short name you choose (lowercase, e.g. off1)
#   pool    = official (Owner/staff music), community (user uploads) or shared (both)
#   quotaGb = optional song space for that account (default 10); full at 85%
# Example:
#   CLOUDINARY_ACCOUNTS=off1|official|cloud1|111|secret1|10,com1|community|cloud2|222|secret2|10
CLOUDINARY_ACCOUNTS=

# ===== Seed scripts (optional) =====
# Contact URL or email sent to Wikipedia when `npm run seed:artists` fetches artist photos.
# Wikimedia throttles anonymous scripts; if empty, APP_URL is used.
SEED_CONTACT=

# ===== Storage driver =====
# Leave empty: music goes to Cloudinary (the accounts above). "local" = disk, for offline
# development only (never in production). "s3" = Cloudflare R2 / AWS S3 (spare option).
STORAGE_DRIVER=
LOCAL_STORAGE_DIR=.storage
# Spare option only — not needed with Cloudinary. R2 / S3 bucket details:
# R2 endpoint looks like https://<account-id>.r2.cloudflarestorage.com (leave empty for AWS S3)
S3_ENDPOINT=your_s3_endpoint_here
S3_REGION=auto
S3_BUCKET=your_s3_bucket_here
S3_ACCESS_KEY_ID=your_s3_access_key_id_here
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key_here
# Optional public / CDN URL for cover images (R2 public bucket or custom domain), no trailing slash
S3_PUBLIC_BASE_URL=
# How long signed links stay valid (seconds)
STREAM_URL_TTL_SECONDS=14400
UPLOAD_URL_TTL_SECONDS=900

# ===== Background jobs (Redis / Upstash) =====
# TODO: Replace with your Upstash Redis URL (rediss://default:<password>@<host>:6379).
# Until set, jobs run inside the API process (development only). With Redis, also run `npm run worker`.
REDIS_URL=your_redis_url_here

# ===== Royalty-free catalog import (optional) =====
# TODO: Replace with a free Jamendo API client id (devportal.jamendo.com) to also import from Jamendo.
# ccMixter needs no key.
JAMENDO_CLIENT_ID=your_jamendo_client_id_here

# ===== Error tracking (Sentry, optional) =====
# TODO: Replace with your Sentry project's DSN (sentry.io → Project → Settings → Client Keys).
# Empty = errors are only written to the logs.
SENTRY_DSN=
# Share of requests traced for performance: 0 = errors only, 0.1 = 10%
SENTRY_TRACES_SAMPLE_RATE=0
